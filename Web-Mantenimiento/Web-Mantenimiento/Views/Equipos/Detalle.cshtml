@model Web_Mantenimiento.Models.Equipos.EquipoViewModel
@{
    ViewData["Title"] = $"Equipo {Model.CodigoEquipo}";
    var rol = Context.Session.GetString("Rol");
    var puedeGestionar = rol is "Administrador" or "Supervisor";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Nombre</h2>
        <span class="text-muted">Código: @Model.CodigoEquipo</span>
    </div>
    <div class="d-flex gap-2">
        @if (puedeGestionar)
        {
            <a asp-action="Editar" asp-route-codigoEquipo="@Model.CodigoEquipo" class="btn btn-primary">Editar</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Model.CodigoEquipo</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Tipo de equipo</dt>
            <dd class="col-sm-9">@Model.TipoEquipoNombre</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.MarcaNombre</dd>

            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.ModeloNombre</dd>

            <dt class="col-sm-3">Ubicación</dt>
            <dd class="col-sm-9">@Model.UbicacionNombre</dd>

            <dt class="col-sm-3">Fecha de adquisición</dt>
            <dd class="col-sm-9">@Model.FechaAdquisicion.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><partial name="_EstadoBadge" model="Model.EstadoNombre" /></dd>
        </dl>
    </div>
</div>
