@model Web_Mantenimiento.Models.Equipos.EquipoListadoViewModel
@{
    ViewData["Title"] = "Equipos";
    var rol = Context.Session.GetString("Rol");
    var puedeGestionar = rol is "Administrador" or "Supervisor";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Equipos</h2>
        <p class="text-muted mb-0">Parque de equipos registrados en la empresa</p>
    </div>

    @if (puedeGestionar)
    {
        <a asp-action="Crear" class="btn btn-primary">Nuevo equipo</a>
    }
</div>

<partial name="_MensajesTempData" />

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text"
               name="busqueda"
               value="@Model.Busqueda"
               class="form-control"
               placeholder="Buscar por código o nombre..." />
    </div>
    <div class="col-md-4">
        <select name="ordenarPor" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(Model.OrdenarPor))">Código (A-Z)</option>
            <option value="codigo_desc" selected="@(Model.OrdenarPor == "codigo_desc")">Código (Z-A)</option>
            <option value="nombre" selected="@(Model.OrdenarPor == "nombre")">Nombre (A-Z)</option>
            <option value="nombre_desc" selected="@(Model.OrdenarPor == "nombre_desc")">Nombre (Z-A)</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Equipos.Count == 0)
        {
            <p class="text-muted mb-0">No se encontraron equipos con los criterios indicados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Marca / Modelo</th>
                            <th>Ubicación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eq in Model.Equipos)
                        {
                            <tr>
                                <td class="fw-semibold">@eq.CodigoEquipo</td>
                                <td>@eq.Nombre</td>
                                <td>@eq.TipoEquipoNombre</td>
                                <td>@eq.MarcaNombre / @eq.ModeloNombre</td>
                                <td>@eq.UbicacionNombre</td>
                                <td><partial name="_EstadoBadge" model="eq.EstadoNombre" /></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Detalle"
                                           asp-route-codigoEquipo="@eq.CodigoEquipo"
                                           class="btn btn-sm btn-outline-info">Ver</a>

                                        @if (puedeGestionar)
                                        {
                                            <a asp-action="Editar"
                                               asp-route-codigoEquipo="@eq.CodigoEquipo"
                                               class="btn btn-sm btn-outline-primary">Editar</a>

                                            <form asp-action="Eliminar"
                                                  method="post"
                                                  onsubmit="return confirm('¿Desea eliminar el equipo @eq.CodigoEquipo?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="codigoEquipo" value="@eq.CodigoEquipo" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Paginacion" model="Model.Paginacion" />
        }
    </div>
</div>
