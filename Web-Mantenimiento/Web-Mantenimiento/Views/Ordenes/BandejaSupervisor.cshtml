@model Web_Mantenimiento.Models.Ordenes.OrdenListadoViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@Model.Titulo</h2>
        <p class="text-muted mb-0">@Model.Subtitulo</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-controller="Planes" asp-action="EjecutarReglas" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="volver" value="BandejaSupervisor" />
            <button type="submit" class="btn btn-outline-danger"
                    title="Escala críticas sin atender (RN-01) y genera órdenes de planes vencidos (RN-06). También corre solo cada pocos minutos.">
                Ejecutar reglas RN-01 / RN-06
            </button>
        </form>
        <a asp-action="Crear" class="btn btn-primary">Nueva orden</a>
    </div>
</div>

<partial name="_MensajesTempData" />
<partial name="_ResumenBandeja" model="Model" />

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Ordenes.Count == 0)
        {
            <p class="text-muted mb-0">No hay órdenes en esta vista.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Equipo</th>
                            <th>Prioridad</th>
                            <th>Fecha límite</th>
                            <th>Estado</th>
                            <th style="min-width: 20rem">Técnico</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Ordenes)
                        {
                            <tr class="@(o.IdEstado == 12 ? "table-danger" : o.EstaVencida ? "table-warning" : "")">
                                <td class="fw-semibold">#@o.Numero</td>
                                <td>
                                    @o.CodigoEquipo - @o.EquipoNombre
                                    <div class="small text-muted">@o.TipoOrdenNombre · Solicitó @o.SolicitanteNombre</div>
                                </td>
                                <td>
                                    <span class="badge @(o.Prioridad == "Critica" ? "bg-danger" : o.Prioridad == "Alta" ? "bg-warning text-dark" : "bg-secondary")">
                                        @o.Prioridad
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    @o.FechaLimite.ToString("yyyy-MM-dd HH:mm")
                                    @if (o.EstaVencida)
                                    {
                                        <span class="badge bg-dark ms-1">Vencida</span>
                                    }
                                </td>
                                <td><partial name="_EstadoBadge" model="o.EstadoNombre" /></td>
                                <td>
                                    @if (o.EstaCerrada)
                                    {
                                        @(o.TecnicoNombre ?? "—")
                                    }
                                    else
                                    {
                                        <form asp-action="AsignarTecnico" method="post" class="d-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Numero" value="@o.Numero" />
                                            <input type="hidden" name="RowVersion" value="@o.RowVersion" />
                                            <input type="hidden" name="Volver" value="BandejaSupervisor" />
                                            <select name="IdentificacionTecnico" class="form-select form-select-sm" required>
                                                <option value="">@(o.TecnicoNombre is null ? "— Sin asignar —" : $"{o.TecnicoNombre} (actual)")</option>
                                                @foreach (var t in Model.Tecnicos.Where(t => t.Value != o.IdentificacionTecnico))
                                                {
                                                    <option value="@t.Value">@t.Text</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm @(o.TecnicoNombre is null ? "btn-primary" : "btn-outline-primary") text-nowrap">
                                                @(o.TecnicoNombre is null ? "Asignar" : "Reasignar")
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Detalle" asp-route-numero="@o.Numero" class="btn btn-sm btn-outline-primary">Gestionar</a>
                                        <a asp-action="Bitacora" asp-route-numero="@o.Numero" class="btn btn-sm btn-outline-dark">Bitácora</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Paginacion" model="Model.Paginacion" />
        }
    </div>
</div>
