@model Web_Mantenimiento.Models.Ordenes.OrdenListadoViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Titulo</h2>
        <p class="text-muted mb-0">@Model.Subtitulo</p>
    </div>
</div>

<partial name="_MensajesTempData" />
<partial name="_ResumenBandeja" model="Model" />

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Ordenes.Count == 0)
        {
            <p class="text-muted mb-0">No tienes órdenes en esta vista. 🎉</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Equipo</th>
                            <th>Tipo</th>
                            <th>Prioridad</th>
                            <th>Fecha límite</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Ordenes)
                        {
                            <tr class="@(o.EstaVencida ? "table-danger" : "")">
                                <td class="fw-semibold">#@o.Numero</td>
                                <td>
                                    @o.CodigoEquipo - @o.EquipoNombre
                                    <div class="small text-muted text-truncate" style="max-width: 22rem">@o.Descripcion</div>
                                </td>
                                <td>@o.TipoOrdenNombre</td>
                                <td>
                                    <span class="badge @(o.Prioridad == "Critica" ? "bg-danger" : o.Prioridad == "Alta" ? "bg-warning text-dark" : "bg-secondary")">
                                        @o.Prioridad
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    @o.FechaLimite.ToString("yyyy-MM-dd HH:mm")
                                    @if (o.EstaVencida)
                                    {
                                        <span class="badge bg-dark ms-1">Vencida</span>
                                    }
                                </td>
                                <td><partial name="_EstadoBadge" model="o.EstadoNombre" /></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (o.IdEstado is 8 or 12)
                                        {
                                            <form asp-action="Atender" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Numero" value="@o.Numero" />
                                                <input type="hidden" name="RowVersion" value="@o.RowVersion" />
                                                <input type="hidden" name="NuevoEstado" value="9" />
                                                <button type="submit" class="btn btn-sm btn-success">Iniciar</button>
                                            </form>
                                        }
                                        else if (o.IdEstado == 9)
                                        {
                                            <form asp-action="Atender" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Numero" value="@o.Numero" />
                                                <input type="hidden" name="RowVersion" value="@o.RowVersion" />
                                                <input type="hidden" name="NuevoEstado" value="10" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning">Esperar repuesto</button>
                                            </form>
                                        }
                                        else if (o.IdEstado == 10)
                                        {
                                            <form asp-action="Atender" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Numero" value="@o.Numero" />
                                                <input type="hidden" name="RowVersion" value="@o.RowVersion" />
                                                <input type="hidden" name="NuevoEstado" value="9" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Reanudar</button>
                                            </form>
                                        }
                                        <a asp-action="Detalle" asp-route-numero="@o.Numero"
                                           class="btn btn-sm btn-primary">@(o.EstaCerrada ? "Ver" : "Repuestos / Cerrar")</a>
                                        <a asp-action="Bitacora" asp-route-numero="@o.Numero"
                                           class="btn btn-sm btn-outline-dark">Bitácora</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Paginacion" model="Model.Paginacion" />
        }
    </div>
</div>
