@model List<Web_Mantenimiento.Models.Ordenes.BitacoraOrdenViewModel>
@{
    var numeroOrden = ViewData["NumeroOrden"];
    ViewData["Title"] = $"Bitácora Orden #{numeroOrden}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Bitácora — Orden #@numeroOrden</h2>
        <p class="text-muted mb-0">Historial cronológico inmutable de transiciones y auditoría</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Detalle" asp-route-numero="@numeroOrden" class="btn btn-outline-primary">Ir al detalle</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<partial name="_MensajesTempData" />

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No existen eventos registrados en la bitácora.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Transición de estado</th>
                            <th>Comentario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(b => b.Fecha))
                        {
                            <tr>
                                <td class="text-nowrap">@item.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.NombreUsuario <small class="text-muted">(@item.Identificacion)</small></td>
                                <td class="text-nowrap">
                                    <partial name="_EstadoBadge" model="item.EstadoAnterior" />
                                    <span class="mx-1">&rarr;</span>
                                    <partial name="_EstadoBadge" model="item.EstadoNuevo" />
                                </td>
                                <td>@item.Comentario</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
