@model Web_Mantenimiento.Models.Ordenes.CrearOrdenViewModel
@inject Web_Mantenimiento.Services.ApiCatalogoService Catalogos
@inject Web_Mantenimiento.Services.ApiEquipoService EquiposService
@inject Web_Mantenimiento.Services.ApiUsuarioService UsuariosService
@{
    ViewData["Title"] = "Nueva orden de trabajo";
    var rol = Context.Session.GetString("Rol");
    var tiposOrden = await Catalogos.ObtenerTiposOrdenAsync();
    var (resEquipos, _) = await EquiposService.ObtenerPaginadoAsync(null, "codigo", 1, 50);
    var equipos = (resEquipos?.Items ?? new())
        .Select(e => new SelectListItem($"{e.CodigoEquipo} - {e.Nombre}", e.CodigoEquipo))
        .ToList();

    var tecnicos = new List<SelectListItem>();
    if (rol is "Administrador" or "Supervisor")
    {
        var (usuarios, _) = await UsuariosService.ObtenerTodosAsync();
        tecnicos = (usuarios ?? new())
            .Where(u => u.RolNombre == "Tecnico" && u.Disponibilidad)
            .Select(u => new SelectListItem($"{u.Identificacion} - {u.NombreCompleto}", u.Identificacion))
            .ToList();
    }
}

<h2 class="mb-3">Crear orden de trabajo</h2>
<partial name="_MensajesTempData" />

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CodigoEquipo" class="form-label"></label>
                    <select asp-for="CodigoEquipo" asp-items="equipos" class="form-select">
                        <option value="">-- Seleccione un equipo --</option>
                    </select>
                    <span asp-validation-for="CodigoEquipo" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="IdTipoOrden" class="form-label"></label>
                    <select asp-for="IdTipoOrden" asp-items="tiposOrden" class="form-select"></select>
                    <span asp-validation-for="IdTipoOrden" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Prioridad" class="form-label"></label>
                    <select asp-for="Prioridad" class="form-select">
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                        <option value="Critica">Critica</option>
                    </select>
                    <span asp-validation-for="Prioridad" class="text-danger"></span>
                </div>

                @if (rol is "Administrador" or "Supervisor")
                {
                    <div class="col-md-6">
                        <label asp-for="IdentificacionTecnico" class="form-label"></label>
                        <select asp-for="IdentificacionTecnico" asp-items="tecnicos" class="form-select">
                            <option value="">-- Sin asignar por ahora --</option>
                        </select>
                    </div>
                }

                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Crear orden</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
