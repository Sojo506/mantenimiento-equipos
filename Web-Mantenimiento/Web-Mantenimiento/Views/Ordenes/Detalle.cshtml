@model Web_Mantenimiento.Models.Ordenes.OrdenViewModel
@{
    ViewData["Title"] = $"Orden #{Model.Numero}";
    var rol = Context.Session.GetString("Rol");
    var puedeOperar = rol is "Administrador" or "Supervisor" or "Tecnico";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Orden de Trabajo #@Model.Numero</h2>
        <span class="text-muted">@Model.CodigoEquipo - @Model.EquipoNombre</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Bitacora" asp-route-numero="@Model.Numero" class="btn btn-outline-dark">Ver Bitácora</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<partial name="_MensajesTempData" />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><partial name="_EstadoBadge" model="Model.EstadoNombre" /></dd>

            <dt class="col-sm-3">Tipo / Prioridad</dt>
            <dd class="col-sm-9">@Model.TipoOrdenNombre — <strong>@Model.Prioridad</strong></dd>

            <dt class="col-sm-3">Solicitante</dt>
            <dd class="col-sm-9">@Model.SolicitanteNombre (@Model.IdentificacionSolicitante)</dd>

            <dt class="col-sm-3">Técnico</dt>
            <dd class="col-sm-9">@(Model.TecnicoNombre ?? "Sin asignar")</dd>

            <dt class="col-sm-3">Creación / Límite</dt>
            <dd class="col-sm-9">@Model.FechaCreacion.ToString("yyyy-MM-dd HH:mm") / @Model.FechaLimite.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Tiempo invertido</dt>
            <dd class="col-sm-9">@Model.TiempoInvertido.ToString("N2") horas</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Repuestos utilizados</div>
    <div class="card-body">
        @if (Model.Repuestos.Count == 0)
        {
            <p class="text-muted mb-0">
                @(Model.SinRepuestos ? $"Cerrada sin repuestos: {Model.JustificacionSinRepuestos}" : "No hay repuestos asignados a esta orden.")
            </p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Repuesto</th>
                        <th>Cantidad</th>
                        <th>Costo aplicado</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Repuestos)
                    {
                        <tr>
                            <td>@r.CodigoRepuesto</td>
                            <td>@r.NombreRepuesto</td>
                            <td>@r.CantidadUsada</td>
                            <td>₡@r.CostoAplicado.ToString("N2")</td>
                            <td>₡@r.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (puedeOperar && Model.IdEstado != 11)
{
    <partial name="_OrdenAcciones" model="Model" />
}
