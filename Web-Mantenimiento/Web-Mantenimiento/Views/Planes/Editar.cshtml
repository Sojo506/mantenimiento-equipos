@model Web_Mantenimiento.Models.Planes.EditarPlanViewModel
@{
    ViewData["Title"] = $"Editar plan #{Model.IdPlanMantenimiento}";
}

<h2 class="mb-3">Editar plan #@Model.IdPlanMantenimiento</h2>
<partial name="_MensajesTempData" />

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdPlanMantenimiento" />
            <input type="hidden" asp-for="CodigoEquipo" />
            <input type="hidden" asp-for="EquipoNombre" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CodigoEquipo" class="form-label"></label>
                    <input value="@Model.CodigoEquipo - @Model.EquipoNombre" class="form-control" disabled />
                </div>

                <div class="col-md-2">
                    <label asp-for="Frecuencia" class="form-label"></label>
                    <input asp-for="Frecuencia" class="form-control" type="number" min="1" max="365" />
                    <span asp-validation-for="Frecuencia" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="ProximaFecha" class="form-label"></label>
                    <input asp-for="ProximaFecha" class="form-control" type="date" />
                    <span asp-validation-for="ProximaFecha" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="IdEstado" class="form-label"></label>
                    <select asp-for="IdEstado" class="form-select">
                        <option value="1">Activo</option>
                        <option value="2">Inactivo</option>
                    </select>
                    <span asp-validation-for="IdEstado" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Actualizar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
