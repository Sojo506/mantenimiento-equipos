@model Web_Mantenimiento.Models.Reportes.ReportesFiltroViewModel
@{
    ViewData["Title"] = "Reportes Analíticos y Exportación CSV";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-0">Centro de Reportes y Exportación CSV</h2>
        <p class="text-muted mb-0">
            Descarga de reportes gerenciales en formato CSV y consulta de consumo de repuestos por período.
        </p>
    </div>
</div>

<partial name="_MensajesTempData" />

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Rango de fechas para reportes por período</div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Fecha inicio</label>
                <input type="date" name="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha fin</label>
                <input type="date" name="fechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Actualizar vista previa</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold">1. Consumo de Repuestos</h6>
                    <p class="text-muted small">
                        Resumen por período con cantidades consumidas, costos acumulados y órdenes cerradas.
                    </p>
                </div>
                <a asp-action="DescargarCsv"
                   asp-route-tipo="consumo-repuestos"
                   asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                   asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                   class="btn btn-success btn-sm w-100">
                    Descargar CSV
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold">2. Órdenes por Estado y Prioridad</h6>
                    <p class="text-muted small">
                        Detalle de órdenes preventivas y correctivas, tiempos invertidos, plazos límite y costos de repuestos.
                    </p>
                </div>
                <a asp-action="DescargarCsv"
                   asp-route-tipo="ordenes"
                   asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                   asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                   class="btn btn-outline-success btn-sm w-100">
                    Descargar CSV
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold">3. Equipos Críticos y Fallas</h6>
                    <p class="text-muted small">
                        Consolidado del parque de equipos, reincidencia de fallas, estado actual y horas acumuladas.
                    </p>
                </div>
                <a asp-action="DescargarCsv"
                   asp-route-tipo="equipos-criticos"
                   class="btn btn-outline-success btn-sm w-100">
                    Descargar CSV
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold">4. Productividad de Técnicos</h6>
                    <p class="text-muted small">
                        Carga operativa por técnico, órdenes en proceso, cerradas, especialidad y horas registradas.
                    </p>
                </div>
                <a asp-action="DescargarCsv"
                   asp-route-tipo="productividad-tecnicos"
                   class="btn btn-outline-success btn-sm w-100">
                    Descargar CSV
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">
        Vista Previa — Consumo de Repuestos en el Período
    </div>
    <div class="card-body">
        @if (Model.ConsumoRepuestos.Count == 0)
        {
            <p class="text-muted mb-0">No se registran consumos de repuestos en órdenes cerradas dentro del período seleccionado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre del Repuesto</th>
                            <th class="text-end">Cantidad Consumida</th>
                            <th class="text-end">Órdenes Asociadas</th>
                            <th class="text-end">Costo Total Acumulado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ConsumoRepuestos)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CodigoRepuesto</td>
                                <td>@item.NombreRepuesto</td>
                                <td class="text-end">@item.CantidadTotalConsumida</td>
                                <td class="text-end">@item.NumeroDeOrdenes</td>
                                <td class="text-end">₡@item.CostoTotalAcumulado.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
