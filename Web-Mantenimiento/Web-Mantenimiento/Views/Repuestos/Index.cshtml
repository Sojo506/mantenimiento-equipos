@model Web_Mantenimiento.Models.Repuestos.RepuestoListadoViewModel
@{
    ViewData["Title"] = "Repuestos";
    var rol = Context.Session.GetString("Rol");
    var puedeGestionar = rol is "Administrador" or "Supervisor";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Repuestos</h2>
        <p class="text-muted mb-0">Inventario de bodega y control de stock mínimo</p>
    </div>

    @if (puedeGestionar)
    {
        <a asp-action="Crear" class="btn btn-primary">Nuevo repuesto</a>
    }
</div>

<partial name="_MensajesTempData" />

@if (Model.TotalBajoMinimo > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>
            <strong>Alerta de inventario:</strong> hay @Model.TotalBajoMinimo repuesto(s) en o por debajo del stock mínimo.
        </span>
        @if (Model.SoloBajoMinimo)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-dark">Ver todos</a>
        }
        else
        {
            <a asp-action="Index" asp-route-soloBajoMinimo="true" class="btn btn-sm btn-warning">Ver solo bajo mínimo</a>
        }
    </div>
}

@if (!Model.SoloBajoMinimo)
{
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control"
                   placeholder="Buscar por código o nombre..." />
        </div>
        <div class="col-md-4">
            <select name="ordenarPor" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.OrdenarPor))">Código (A-Z)</option>
                <option value="codigo_desc" selected="@(Model.OrdenarPor == "codigo_desc")">Código (Z-A)</option>
                <option value="nombre" selected="@(Model.OrdenarPor == "nombre")">Nombre (A-Z)</option>
                <option value="nombre_desc" selected="@(Model.OrdenarPor == "nombre_desc")">Nombre (Z-A)</option>
                <option value="stock" selected="@(Model.OrdenarPor == "stock")">Stock (menor a mayor)</option>
                <option value="stock_desc" selected="@(Model.OrdenarPor == "stock_desc")">Stock (mayor a menor)</option>
                <option value="costo" selected="@(Model.OrdenarPor == "costo")">Costo (menor a mayor)</option>
                <option value="costo_desc" selected="@(Model.OrdenarPor == "costo_desc")">Costo (mayor a menor)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Repuestos.Count == 0)
        {
            <p class="text-muted mb-0">No se encontraron repuestos.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Stock</th>
                            <th>Stock mínimo</th>
                            <th>Costo unitario</th>
                            <th>Estado</th>
                            @if (puedeGestionar)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Repuestos)
                        {
                            <tr class="@(r.BajoStockMinimo ? "table-warning" : "")">
                                <td class="fw-semibold">@r.CodigoRepuesto</td>
                                <td>@r.Nombre</td>
                                <td>
                                    @r.Stock
                                    @if (r.BajoStockMinimo)
                                    {
                                        <span class="badge bg-danger ms-1">Bajo mínimo</span>
                                    }
                                </td>
                                <td>@r.StockMinimo</td>
                                <td>₡@r.CostoUnitario.ToString("N2")</td>
                                <td><partial name="_EstadoBadge" model="r.EstadoNombre" /></td>
                                @if (puedeGestionar)
                                {
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Editar"
                                               asp-route-codigoRepuesto="@r.CodigoRepuesto"
                                               class="btn btn-sm btn-outline-primary">Editar</a>

                                            <form asp-action="Eliminar"
                                                  method="post"
                                                  onsubmit="return confirm('¿Desea eliminar el repuesto @r.CodigoRepuesto?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="codigoRepuesto" value="@r.CodigoRepuesto" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.SoloBajoMinimo)
            {
                <partial name="_Paginacion" model="Model.Paginacion" />
            }
        }
    </div>
</div>
