@model Web_Mantenimiento.Models.Comun.PaginacionViewModel

@if (Model.Meta.TotalPages > 1)
{
    var inicio = Math.Max(1, Model.Meta.PageNumber - 2);
    var fin = Math.Min(Model.Meta.TotalPages, Model.Meta.PageNumber + 2);

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
        <small class="text-muted">
            Página @Model.Meta.PageNumber de @Model.Meta.TotalPages (@Model.Meta.TotalItems registros)
        </small>

        <nav aria-label="Paginación">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Meta.HasPrevious ? "" : "disabled")">
                    <a class="page-link"
                       asp-controller="@Model.Controlador"
                       asp-action="@Model.Accion"
                       asp-route-pagina="@(Model.Meta.PageNumber - 1)"
                       asp-route-tamanoPagina="@Model.Meta.PageSize"
                       asp-route-busqueda="@Model.Busqueda"
                       asp-route-ordenarPor="@Model.OrdenarPor"
                       asp-all-route-data="Model.Filtros">
                        Anterior
                    </a>
                </li>

                @for (var i = inicio; i <= fin; i++)
                {
                    <li class="page-item @(i == Model.Meta.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-controller="@Model.Controlador"
                           asp-action="@Model.Accion"
                           asp-route-pagina="@i"
                           asp-route-tamanoPagina="@Model.Meta.PageSize"
                           asp-route-busqueda="@Model.Busqueda"
                           asp-route-ordenarPor="@Model.OrdenarPor"
                           asp-all-route-data="Model.Filtros">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Meta.HasNext ? "" : "disabled")">
                    <a class="page-link"
                       asp-controller="@Model.Controlador"
                       asp-action="@Model.Accion"
                       asp-route-pagina="@(Model.Meta.PageNumber + 1)"
                       asp-route-tamanoPagina="@Model.Meta.PageSize"
                       asp-route-busqueda="@Model.Busqueda"
                       asp-route-ordenarPor="@Model.OrdenarPor"
                       asp-all-route-data="Model.Filtros">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
