
@model List<Web_Mantenimiento.Models.Usuarios.UsuarioViewModel>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Gestión de usuarios</h2>
        <p class="text-muted">Administración de usuarios y técnicos</p>
    </div>

    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Nuevo usuario
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null || ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @(TempData["Error"] ?? ViewBag.Error)
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">
                No hay usuarios registrados o no fue posible obtenerlos.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre completo</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Especialidad</th>
                            <th>Estado</th>
                            <th>Disponibilidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.Identificacion</td>
                                <td>@usuario.NombreCompleto</td>
                                <td>@usuario.Correo</td>
                                <td>@usuario.RolNombre</td>
                                <td>@(usuario.EspecialidadNombre ?? "No aplica")</td>
                                <td>@usuario.EstadoNombre</td>
                                <td>
                                    @if (usuario.Disponibilidad)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No disponible</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Editar"
                                           asp-route-identificacion="@usuario.Identificacion"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-action="Eliminar"
                                              method="post"
                                              onsubmit="return confirm('¿Desea eliminar este usuario?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="identificacion"
                                                   value="@usuario.Identificacion" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
